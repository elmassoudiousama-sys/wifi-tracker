# Password to open the web dashboard on Vercel
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Secret token shared with the Huawei phone agent (config.json -> api_secret)
AGENT_SECRET=CHANGE_THIS_SECRET_TOKEN

# Required on Vercel (free Upstash Redis REST API from Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
