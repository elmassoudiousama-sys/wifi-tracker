# Password to open the web dashboard on Vercel
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Secret token shared with the phone agent (config.json -> api_secret)
AGENT_SECRET=CHANGE_THIS_SECRET_TOKEN

# Primary database on Vercel (Neon PostgreSQL)
DATABASE_URL=

# Optional fallback: Upstash Redis REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
